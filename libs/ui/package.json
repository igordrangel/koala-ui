{
  "name": "ui",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "prestart": "node generate-icons.js",
    "start": "ng serve",
    "prebuild": "node generate-icons.js",
    "build": "ng build",
    "build:prod": "bunx ng build --configuration production && node scripts/post-build.mjs",
    "generate:llms": "node ../../scripts/generate-llms.js",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "e2e": "playwright test --pass-with-no-tests",
    "e2e:headed": "playwright test --headed",
    "e2e:ui": "playwright test --ui"
  },
  "private": true,
  "packageManager": "bun@1.3.6",
  "dependencies": {
    "@angular/aria": "^22",
    "@angular/cdk": "^22",
    "@angular/common": "^22.0.6",
    "@angular/compiler": "^22.0.6",
    "@angular/core": "^22.0.6",
    "@angular/forms": "^22.0.6",
    "@angular/platform-browser": "^22.0.6",
    "@angular/router": "^22.0.6",
    "@ngx-loading-bar/core": "^7.0.1",
    "@ngx-loading-bar/router": "^7.0.1",
    "@tiptap/extension-file-handler": "^3.27.1",
    "@tiptap/extension-highlight": "^3.27.1",
    "@tiptap/extension-image": "^3.27.1",
    "@tiptap/extension-table": "^3.27.1",
    "@tiptap/extension-text-align": "^3.27.1",
    "@tiptap/starter-kit": "^3.27.1",
    "cally": "^0.9.2",
    "daisyui": "^5.5.19",
    "jwt-decode": "^4.0.0",
    "minisearch": "^7.2.0",
    "ngx-markdown": "^22",
    "ngx-tiptap": "^14.0.1",
    "prism-themes": "^1.9.0",
    "prismjs": "^1.30.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.6",
    "@angular/cli": "^22.0.6",
    "@angular/compiler-cli": "^22.0.6",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4.1.12",
    "angular-eslint": "^22",
    "jsdom": "^28.0.0",
    "postcss": "^8.5.3",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.12",
    "typescript": "~6.0.3",
    "vitest": "^4.0.8"
  }
}
